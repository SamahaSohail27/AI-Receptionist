# AI Medical Receptionist — Environment Variables
# Copy to .env and fill in your keys. Never commit .env.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:8000

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_receptionist

# -----------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------
# Telephony — PRIMARY: Plivo (~$0.0085/min for Pakistan)
# -----------------------------------------------------------------------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TELEPHONY_PRIMARY=plivo

# Telephony — FALLBACK: Twilio (most reliable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEPHONY_FALLBACK=twilio

# Telephony — SECONDARY: Telnyx
TELNYX_API_KEY=

# -----------------------------------------------------------------------
# STT
# -----------------------------------------------------------------------
# Deepgram — DEFAULT for Urdu (ur-PK) and English
DEEPGRAM_API_KEY=

# Groq — DEFAULT for Punjabi (pa-PK), fastest multilingual
GROQ_API_KEY=

# Azure Speech — ur-PK explicit locale (best Pakistani Urdu accuracy)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Google Speech (optional fallback)
GOOGLE_CREDENTIALS_JSON=/path/to/service-account.json

# AssemblyAI (English-only backup)
ASSEMBLYAI_API_KEY=

# -----------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------
# OpenAI — DEFAULT (gpt-4o-mini standard, gpt-4o quality)
OPENAI_API_KEY=

# Anthropic — Claude Haiku/Sonnet fallback
ANTHROPIC_API_KEY=

# Google Gemini (cheapest multilingual option)
GOOGLE_API_KEY=

# Provider selection
LLM_PROVIDER=openai
LLM_MODEL_STANDARD=gpt-4o-mini
LLM_MODEL_QUALITY=gpt-4o
LLM_TEMPERATURE=0.3

# -----------------------------------------------------------------------
# TTS
# -----------------------------------------------------------------------
# Azure Neural — DEFAULT for Urdu/Punjabi
# Uses AZURE_SPEECH_KEY above

# OpenAI — DEFAULT for English (nova voice, tts-1)
# Uses OPENAI_API_KEY above

# ElevenLabs (IMPORTANT: Creator key required from Pakistan — free tier blocked)
ELEVENLABS_API_KEY=

# Cartesia (English only, fastest)
CARTESIA_API_KEY=

# -----------------------------------------------------------------------
# Voice Pipeline — SACRED parameters (do NOT change without full test run)
# -----------------------------------------------------------------------
VAD_CONFIDENCE=0.6
VAD_START_SECS=0.2
VAD_STOP_SECS=0.6
VAD_MIN_VOLUME=0.5
STT_CONFIDENCE_UR=0.45
STT_CONFIDENCE_EN=0.70
STT_CONFIDENCE_PA=0.40
STT_ENDPOINTING_MS=600
STT_UTTERANCE_END_MS=1500

# -----------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------
SLOT_LOCK_SECONDS=45
DEFAULT_LANGUAGE=ur-PK
TIMEZONE=Asia/Karachi
REMINDER_HOURS_BEFORE=24,2

# -----------------------------------------------------------------------
# TTS Cache
# -----------------------------------------------------------------------
TTS_CACHE_DIR=tts_cache
TTS_CACHE_MAX_MB=500
